---
import "../styles/global.css";

const pageTitle = "Aulas — Tutoria IA";
const pageDescription = "Selecione uma aula para começar.";
---

<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,600&family=Atkinson+Hyperlegible:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      try {
        var savedScale = localStorage.getItem("tutoria-text-scale");
        if (savedScale) document.documentElement.setAttribute("data-text-scale", savedScale);
        var savedContrast = localStorage.getItem("tutoria-contrast");
        if (savedContrast === "true") document.documentElement.setAttribute("data-contrast", "high");
      } catch (error) {}
    </script>
  </head>
  <body>
    <a href="#conteudo" class="skip-link">Pular para o conteúdo</a>

    <header class="site-header">
      <div class="site-header-inner">
        <a href="/" class="brand" style="text-decoration: none;">Tutoria IA</a>

        <div class="text-size-control" role="group" aria-label="Tamanho do texto">
          <span class="text-size-label">Tamanho do texto</span>
          <button type="button" class="text-size-btn" data-text-scale-btn="0" aria-pressed="false" style="font-size: 0.9375rem">A</button>
          <button type="button" class="text-size-btn" data-text-scale-btn="1" aria-pressed="true" style="font-size: 1.1875rem">A</button>
          <button type="button" class="text-size-btn" data-text-scale-btn="2" aria-pressed="false" style="font-size: 1.4375rem">A</button>
        </div>

        <button type="button" class="contrast-toggle" id="contrast-toggle" aria-pressed="false">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
            <path d="M12 2a10 10 0 0 0 0 20Z" fill="currentColor"></path>
          </svg>
          <span class="contrast-toggle-full">Mais contraste</span>
          <span class="contrast-toggle-short">Contraste</span>
        </button>
      </div>
    </header>

    <main id="conteudo" class="container">
      <a href="/" style="display: inline-flex; align-items: center; gap: 8px; font-weight: bold; color: var(--t-accent); text-decoration: none; margin-bottom: 24px;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        Voltar ao Início
      </a>

      <div class="page-hero" style="padding: 20px 0; text-align: left;">
        <h1 style="font-size: 2.5rem; margin-bottom: 12px; font-family: var(--t-head);">Aulas</h1>
        <p style="font-size: 1.25rem; color: var(--t-bodyc); margin-bottom: 40px;">Selecione uma aula para começar.</p>
        
        <section class="category">
          <ul class="video-grid" style="list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 36px;">
            <li>
              <a href="/aulas/1" class="video-card" style="display: flex; flex-direction: column; border: 1px solid var(--t-border); border-radius: var(--t-card-r); padding: 32px; background: var(--t-tint); text-decoration: none; transition: transform 0.2s ease, box-shadow 0.2s ease;">
                <div style="font-size: 4rem; font-family: var(--t-head); font-weight: bold; color: var(--t-accent); line-height: 1; margin-bottom: 16px;">1</div>
                <h3 class="video-card-title" style="margin: 0 0 8px 0; font-size: 1.75rem; color: var(--t-ink);">Aula 1: Fazer Ser Lembrada</h3>
                
                <p style="color: var(--t-muted); margin: 0; font-size: 1.125rem;">
                  Construa sua mensagem central e o Post Fixo 2 para que o mercado lembre do valor do seu trabalho.
                </p>
              </a>
            </li>
          </ul>
        </section>
      </div>
    </main>

    <script>
      const TEXT_SCALE_KEY = "tutoria-text-scale";
      const textScaleButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-text-scale-btn]"));
      function applyTextScale(step: string) {
        document.documentElement.setAttribute("data-text-scale", step);
        for (const button of textScaleButtons) {
          button.setAttribute("aria-pressed", String(button.dataset.textScaleBtn === step));
        }
      }
      for (const button of textScaleButtons) {
        button.addEventListener("click", () => {
          const step = button.dataset.textScaleBtn ?? "1";
          applyTextScale(step);
          try { localStorage.setItem(TEXT_SCALE_KEY, step); } catch {}
        });
      }
      applyTextScale(document.documentElement.getAttribute("data-text-scale") ?? "1");

      const CONTRAST_KEY = "tutoria-contrast";
      const contrastToggle = document.getElementById("contrast-toggle") as HTMLButtonElement;
      function applyContrast(isHigh: boolean) {
        document.documentElement.setAttribute("data-contrast", isHigh ? "high" : "normal");
        contrastToggle?.setAttribute("aria-pressed", String(isHigh));
      }
      contrastToggle?.addEventListener("click", () => {
        const next = contrastToggle.getAttribute("aria-pressed") !== "true";
        applyContrast(next);
        try { localStorage.setItem(CONTRAST_KEY, String(next)); } catch {}
      });
      applyContrast(document.documentElement.getAttribute("data-contrast") === "high");
    </script>
  </body>
</html>
