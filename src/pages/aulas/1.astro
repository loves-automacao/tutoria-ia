---
import "../../styles/global.css";

const pageTitle = "Aula 1: Fazer Ser Lembrada — Tutoria IA";
const pageDescription = "Construa sua mensagem central e o Post Fixo 2.";

const steps = [
  {
    step: "Passo 1",
    title: "Decida pelo que você quer ser lembrada",
    instructions: "O assistente vai analisar o que já conhece sobre você e apresentar 3 opções. Leia as três opções e escolha apenas UMA. Não procure a frase perfeita, escolha a ideia que melhor representa o valor que quer associar ao seu nome.",
    promptTitle: "Copiar Prompt 1",
    prompt: `Considerando tudo o que você já conhece sobre mim, meu negócio, meu público, minha experiência e as decisões do RESSOA Lab, me ajude a responder:\n\n“Qual é a principal ideia pela qual eu deveria ser lembrada?”\n\nNão quero slogan. Quero uma ideia simples e estratégica que conecte quem eu ajudo, qual problema ou desejo conheço profundamente e qual valor quero representar.\n\nApresente apenas 3 opções. Explique cada uma delas, sem pressa, com exemplos fáceis de entender e me ajude a tomar uma decisão assertiva sobre qual é a melhor para o meu momento agora. Para ficar mais fácil de executar este comando, antes, me faça 2 perguntas para te guiar a fornecer o melhor resultado.`
  },
  {
    step: "Passo 2",
    title: "Transforme a ideia em mensagem central",
    instructions: "Quando ele pedir, informe a ideia escolhida no Passo 1. Ele vai transformar essa ideia em possibilidades de mensagem central. Escolha UMA mensagem que será a direção estratégica.",
    promptTitle: "Copiar Prompt 2",
    prompt: `Escolhi esta ideia:\n[COLE AQUI]\n\nAgora transforme essa ideia em uma mensagem central simples para meu negócio.\nEvite palavras técnicas, frases genéricas e linguagem de propaganda.\nQuero que a pessoa entenda rapidamente:\no que eu defendo,\npara quem isso importa,\ne por que meu trabalho tem valor.`
  },
  {
    step: "Passo 3",
    title: "Construa seu Post Fixo 2",
    instructions: "Antes de criar o carrossel, ele fará 3 perguntas (paleta de cores, seu @, e próximo passo). O carrossel será construído UM SLIDE POR VEZ. Leia cada slide, confira a mensagem, aprove ou peça ajustes antes de avançar.",
    promptTitle: "Copiar Prompt 3",
    prompt: `RESSOA, vamos construir meu POST FIXO 2.\nEste post pertence ao movimento FAZER SER LEMBRADA + FAZER SER ENTENDIDA.\nA ideia que escolhi no exercício anterior e pela qual quero começar a ser lembrada é:\n[COLE AQUI A IDEIA ESCOLHIDA]\n\nSua tarefa é transformar essa ideia em um carrossel estratégico, autoral, claro e visualmente forte para ficar fixado no meu Instagram.\nO objetivo não é apresentar meu currículo nem listar meus serviços.\nQuero que uma pessoa que encontre meu perfil consiga entender:\nO que meu público vive.\nO que eu compreendo sobre essa questão.\nQual é a minha forma de enxergá-la.\nQual valor meu trabalho entrega.\nPor que essa ideia deve ser associada ao meu nome.\nQual próximo passo ela pode dar comigo.\n\nANTES DE COMEÇAR\nUse tudo o que você já conhece e tem registrado sobre mim, meu negócio, meu público, minha experiência, minha comunicação e as decisões anteriores do RESSOA Lab.\nAntes de criar qualquer slide, faça apenas estas 3 perguntas:\nQual é a paleta de cores da sua marca? Peça os códigos das cores, se eu tiver.\nQual é o seu @ do Instagram? Ele aparecerá discretamente no rodapé dos quatro slides.\nQual é o próximo passo real que uma pessoa interessada pode dar com você hoje? Adapte os exemplos ao meu negócio.\n\nEspere minhas respostas.\nDepois, construa exatamente 4 slides (um por vez após aprovação).`
  },
  {
    step: "Passo 4",
    title: "Crie a Legenda",
    instructions: "Somente depois de aprovar os quatro slides. A legenda deve complementar o post, não copiar os slides. Confira se o texto parece com sua voz e se o convite final corresponde ao passo real.",
    promptTitle: "Copiar Prompt 4",
    prompt: `PROMPT | LEGENDA DO POST FIXO 2\nRESSOA, meu POST FIXO 2 está pronto.\nAgora crie a legenda estratégica que acompanhará esse carrossel.\nUse tudo o que você já conhece sobre mim, meu negócio, meu público, minha voz e a mensagem central que acabamos de construir.\n\nA legenda precisa complementar o carrossel. Não repita o texto dos slides.\nObjetivo: aprofundar a ideia, mostrar que compreendo o público, reforçar autoridade, ajudar a entender o valor e conduzir ao próximo passo.\n\nEstrutura: Abertura (frase forte), Identificação (dor/desejo), Autoridade (minha perspectiva), Valor (como ajudo), Fechamento (ideia central) e CTA.`
  },
  {
    step: "Passo 5",
    title: "Coloque em Movimento",
    instructions: "Monte o carrossel seguindo a direção visual. Revise o texto, seu @ e cores. Por fim, publique no feed, fixe o post e registre sua decisão.",
    promptTitle: "Copiar Prompt 5",
    prompt: `Registre como decisão estratégica do Encontro 3 do RESSOA Lab:\n\nRepita aqui, e grave qual é a mensagem pela qual quero ser lembrada:\ne mensagem central escolhida:\n\nMantendo esta decisão:\nMeu Post Fixado 2 construído a partir dessa direção, deve gerar o valor na minha audiência de tal maneira que os clientes certos confiem e valorizem o meu serviço, produto e autoridade.\n\nQual a sua análise final?\n\nNas próximas atividades, preserve essa decisão e evite criar conteúdos que contradigam ou dispersem essa mensagem.`
  }
];
---

<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,600&family=Atkinson+Hyperlegible:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      try {
        var savedScale = localStorage.getItem("tutoria-text-scale");
        if (savedScale) document.documentElement.setAttribute("data-text-scale", savedScale);
        var savedContrast = localStorage.getItem("tutoria-contrast");
        if (savedContrast === "true") document.documentElement.setAttribute("data-contrast", "high");
      } catch (error) {}
    </script>
    <style>
      .step-card {
        border: 1px solid var(--t-border);
        border-radius: var(--t-card-r);
        padding: 32px;
        background: var(--t-tint);
        margin-bottom: 24px;
      }
      .step-header {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 16px;
      }
      .step-number {
        font-size: 1.5rem;
        font-weight: bold;
        color: #fff;
        background: var(--t-accent);
        border-radius: 50%;
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }
      .step-title {
        font-family: var(--t-head);
        font-size: 1.75rem;
        color: var(--t-ink);
        margin: 0;
      }
      .step-desc {
        font-size: 1.125rem;
        color: var(--t-bodyc);
        margin: 0 0 20px 0;
        line-height: 1.6;
      }
      .copy-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 14px 24px;
        background: transparent;
        color: var(--t-accent);
        border: 2px solid var(--t-accent);
        border-radius: var(--t-r);
        font-weight: bold;
        font-size: 1.125rem;
        cursor: pointer;
        transition: all 0.2s;
        text-align: center;
      }
      .copy-btn:hover {
        background: var(--t-accent);
        color: #fff;
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-inner">
        <a href="/" class="brand" style="text-decoration: none;">Tutoria IA</a>

        <div class="text-size-control" role="group" aria-label="Tamanho do texto">
          <span class="text-size-label">Tamanho do texto</span>
          <button type="button" class="text-size-btn" data-text-scale-btn="0" aria-pressed="false" style="font-size: 0.9375rem">A</button>
          <button type="button" class="text-size-btn" data-text-scale-btn="1" aria-pressed="true" style="font-size: 1.1875rem">A</button>
          <button type="button" class="text-size-btn" data-text-scale-btn="2" aria-pressed="false" style="font-size: 1.4375rem">A</button>
        </div>

        <button type="button" class="contrast-toggle" id="contrast-toggle" aria-pressed="false">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
            <path d="M12 2a10 10 0 0 0 0 20Z" fill="currentColor"></path>
          </svg>
          <span class="contrast-toggle-short">Contraste</span>
        </button>
      </div>
    </header>

    <main class="container">
      <a href="/aulas" style="display: inline-flex; align-items: center; gap: 8px; font-weight: bold; color: var(--t-accent); text-decoration: none; margin-bottom: 24px;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        Voltar para Aulas
      </a>

      <div style="padding: 20px 0; text-align: left;">
        <h1 style="font-size: 2.5rem; margin-bottom: 12px; font-family: var(--t-head);">Aula 1: Fazer Ser Lembrada</h1>
        <p style="font-size: 1.25rem; color: var(--t-bodyc); margin-bottom: 40px;">Siga os passos abaixo, copiando os prompts e seguindo as instruções para construir sua mensagem central.</p>
        
        <div class="steps-container">
          {steps.map((s, index) => (
            <div class="step-card">
              <div class="step-header">
                <div class="step-number">{index + 1}</div>
                <h2 class="step-title">{s.title}</h2>
              </div>
              <p class="step-desc">{s.instructions}</p>
              
              <button class="copy-btn" data-prompt={s.prompt}>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                </svg>
                <span class="btn-text">{s.promptTitle}</span>
              </button>
            </div>
          ))}
        </div>
        
        <div style="margin-top: 48px; text-align: center;">
          <a href="https://drive.google.com/drive/folders/10XuwM5aeI2IdjVhxj3TmwHICd6XEO5qm?usp=sharing" target="_blank" rel="noopener noreferrer" style="display: inline-flex; align-items: center; gap: 12px; padding: 16px 32px; background: var(--t-accent); color: #fff; font-size: 1.25rem; font-weight: bold; text-decoration: none; border-radius: var(--t-r); transition: background 0.2s;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            Baixar Material Oficial
          </a>
        </div>
      </div>
    </main>

    <script>
      // Lógica de cópia dos prompts
      const copyBtns = document.querySelectorAll('.copy-btn');
      copyBtns.forEach(btn => {
        btn.addEventListener('click', async () => {
          const promptText = btn.getAttribute('data-prompt');
          if (!promptText) return;
          
          try {
            await navigator.clipboard.writeText(promptText);
            const textSpan = btn.querySelector('.btn-text');
            const originalText = textSpan.textContent;
            textSpan.textContent = "Copiado com sucesso!";
            
            setTimeout(() => {
              textSpan.textContent = originalText;
            }, 2000);
          } catch (err) {
            console.error('Falha ao copiar:', err);
          }
        });
      });
      
      const TEXT_SCALE_KEY = "tutoria-text-scale";
      const textScaleButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-text-scale-btn]"));
      function applyTextScale(step: string) {
        document.documentElement.setAttribute("data-text-scale", step);
        for (const button of textScaleButtons) {
          button.setAttribute("aria-pressed", String(button.dataset.textScaleBtn === step));
        }
      }
      for (const button of textScaleButtons) {
        button.addEventListener("click", () => {
          const step = button.dataset.textScaleBtn ?? "1";
          applyTextScale(step);
          try { localStorage.setItem(TEXT_SCALE_KEY, step); } catch {}
        });
      }
      applyTextScale(document.documentElement.getAttribute("data-text-scale") ?? "1");

      const CONTRAST_KEY = "tutoria-contrast";
      const contrastToggle = document.getElementById("contrast-toggle") as HTMLButtonElement;
      function applyContrast(isHigh: boolean) {
        document.documentElement.setAttribute("data-contrast", isHigh ? "high" : "normal");
        contrastToggle?.setAttribute("aria-pressed", String(isHigh));
      }
      contrastToggle?.addEventListener("click", () => {
        const next = contrastToggle.getAttribute("aria-pressed") !== "true";
        applyContrast(next);
        try { localStorage.setItem(CONTRAST_KEY, String(next)); } catch {}
      });
      applyContrast(document.documentElement.getAttribute("data-contrast") === "high");
    </script>
  </body>
</html>
