---
import type { Video } from "../data/videos";
import { normalizeText } from "../lib/search";

interface Props {
  video: Video;
}

const { video } = Astro.props;
---

<li id={`video-${video.id}`}>
  <button
    type="button"
    class="video-card"
    data-video-card
    data-video-id={video.id}
    data-youtube-id={video.youtubeId}
    data-title={video.title}
    data-title-normalized={normalizeText(video.title)}
  >
    <span class="video-thumb">
      <img
        src={`https://i.ytimg.com/vi/${video.youtubeId}/hqdefault.jpg`}
        alt=""
        loading="lazy"
        width="480"
        height="360"
      />
      <span class="video-play" aria-hidden="true">
        <svg viewBox="0 0 256 256">
          <path d="M232 128 72 224V32Z" opacity="0.2"></path>
          <path
            d="M72 24a16 16 0 0 0-16 16v176a16 16 0 0 0 24.3 13.66l144-88a16 16 0 0 0 0-27.32l-144-88A16 16 0 0 0 72 24Z"
          ></path>
        </svg>
      </span>
    </span>
    <span class="video-card-info">
      <h3 class="video-card-title">{video.title}</h3>
      <span class="video-card-duration">{video.durationLabel}</span>
    </span>
  </button>
</li>
